# Empulse frontend — copy to .env.local (optional for local dev; defaults match below).
# Next.js loads .env.local automatically; client vars must be NEXT_PUBLIC_*.
# Pair with backend/.env → FRONTEND_URL / BACKEND_URL

# Backend API (FastAPI) — used by api-client.ts for all API calls
NEXT_PUBLIC_API_URL=http://localhost:8000

# This app's public URL — for deploy docs / OAuth callback alignment with backend FRONTEND_URL
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# deployment: development (local) or production (Railway/Render)
# production → silent API + /health/db warmup on load (suppresses error toasts until both are up)
NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_APP_ENV=production

# ERA UI: command center layout (default on). Set "false" for classic dashboard only.
# NEXT_PUBLIC_ERA_COMMAND_CENTER=true

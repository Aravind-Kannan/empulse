# PostgreSQL operational database (Docker Compose default)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/empulse

# Cognee LLM — Ollama (https://ollama.com)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_ENDPOINT=http://localhost:11434/v1
LLM_API_KEY=ollama

# Cognee embeddings — Ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_ENDPOINT=http://localhost:11434/api/embed
EMBEDDING_API_KEY=ollama
# HuggingFace tokenizer used for chunk token counting with Ollama embed models
HUGGINGFACE_TOKENIZER=nomic-ai/nomic-embed-text-v1.5

# Cognee storage
COGNEE_DATASET_NAME=empulse_org_chart
COGNEE_VECTOR_DB_PROVIDER=lancedb
COGNEE_GRAPH_DB_PROVIDER=kuzu
ENABLE_BACKEND_ACCESS_CONTROL=false

# PostgreSQL operational database (Docker Compose default)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/empulse

# Cognee LLM — Ollama (https://ollama.com)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_ENDPOINT=http://localhost:11434/v1
LLM_API_KEY=ollama

# Cognee embeddings — Ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_ENDPOINT=http://localhost:11434/api/embed
EMBEDDING_API_KEY=ollama
# HuggingFace tokenizer used for chunk token counting with Ollama embed models
HUGGINGFACE_TOKENIZER=nomic-ai/nomic-embed-text-v1.5

# Cognee storage
COGNEE_DATASET_NAME=empulse_org_chart
COGNEE_VECTOR_DB_PROVIDER=lancedb
COGNEE_GRAPH_DB_PROVIDER=neo4j
COGNEE_GRAPH_DB_URL=bolt://localhost:7687
COGNEE_GRAPH_DB_USERNAME=neo4j
COGNEE_GRAPH_DB_PASSWORD=pleaseletmein
COGNEE_GRAPH_DB_NAME=neo4j
ENABLE_BACKEND_ACCESS_CONTROL=false
# Set to true with neo4j:5-enterprise for a dedicated Neo4j DB per tenant dataset

# Optional guard for /api/internal/* debug routes (leave blank for local dev)
INTERNAL_DEBUG_KEY=

# ERA v2 five-dimension scoring engine (Step 02)
ERA_V2_SCORING=true

# Auth / JWT
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# OAuth providers (optional — leave blank to disable social login buttons server-side)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
